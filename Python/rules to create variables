## The rules to create the variables

##1.The keywords can't be used as varibale

# a = True
# print(a)

# True = 90

##2. The variables should not start with the numbers

a2 = 90
print(a2)

a3b = 99
print(a3b)

# 2ba = 33
# print(2ba)

##3. The variables should not begin with space or have space in between

#  a = 44
#  print( a)

# a b = 900
# print(a b)

ab = 44
print(ab)

##4. The variable should not contain any special character except "_"

# a$b = 9
# print(a$b)

# ab* = 999
# print(ab*)

# %ab = 999
# print(%ab)

a_b = 9
print(a_b)

ab_ = 4
print(ab_)

_ab = 99
print(_ab)

_ = 99
print(_)


##5. The variables can be only alphabets(uppercase, lowercase, or both) or alphanumeric

