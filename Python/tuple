## It is collection of homogeneous or heterogeneous data item enclosed between ()

## syntax: variable = (val1, val2,......)         ##or   Var = val1, val2,.....

Tuple = (1,2,3,4,4)         ## homogeneous tuple
print(type(Tuple))

Tuple = (12, 'program', 333.33, 8-9j, 200)      ## heterogeneous tuple
print(type(Tuple))

print(bool(()))     ## The default value of tuple is () which is internally boolean False

Tuple = 1, 23.3, 'hii'
print(Tuple)
print(type(Tuple))

Tuple = (8)
print(type(Tuple))
Tuple = ('hii')
print(type(Tuple))

Tuple = (8,)
print(type(Tuple))
Tuple = ('hii',)
print(type(Tuple))

###############################################################################

print(dir(Tuple))

## count() and index()

Tuple = (1,1,1,1,2,2,2)
print(Tuple.count(1))
print(Tuple.count(10))

print(Tuple.index(1))

